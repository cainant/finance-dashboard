# Headers de segurança do Cloudflare Pages (fonte única da CSP).
# O plugin `lumen:security-headers` em vite.config.ts lê esta seção `/*`
# e replica os mesmos headers no `vite dev` e no `vite preview`.
#
# CSP compatível com o bundle Vite em produção:
# - script-src 'self' (entry/chunks externos) + cdn.pluggy.ai (widget oficial v2.8.2)
# - style-src 'unsafe-inline' (Tailwind/Recharts/estilos inline do React)
# - img-src: avatar do GitHub e logos oficiais das instituições Pluggy
# - frame-src: iframe do Pluggy Connect
# - connect-src: API do Pluggy (widget/connect token; o iframe tem CSP própria)
# - static.cloudflareinsights.com / cloudflareinsights.com: beacon do Cloudflare Web Analytics,
#   injetado automaticamente pelo Pages em produção (gratuito)
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.pluggy.ai https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://avatars.githubusercontent.com https://pluggy.ai https://*.pluggy.ai; font-src 'self'; connect-src 'self' https://api.pluggy.ai https://connect.pluggy.ai https://cloudflareinsights.com; frame-src https://connect.pluggy.ai; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
